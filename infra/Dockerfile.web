# syntax=docker/dockerfile:1

# Static demo client, served by nginx, which also reverse-proxies /api to the
# API container. Build context is the workspace root for the same reason as
# apps/api/Dockerfile: pnpm needs the root manifest, the lockfile, and the
# workspace definition to resolve @scheduler/contracts.
#
# Serving the SPA and the API from one origin is not a convenience. A JSON POST
# is never a CORS-simple request, so a cross-origin booking would pay an OPTIONS
# preflight on every attempt, and the API sets no `exposedHeaders`, which would
# make X-Request-Id unreadable from the browser. Same-origin keeps both
# properties that apps/web/src/lib/env.ts documents.

FROM node:22-slim AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY apps/api/package.json apps/api/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN pnpm install --frozen-lockfile

COPY tsconfig.base.json ./
COPY packages/contracts packages/contracts
COPY apps/web apps/web
# vite.config.ts aliases @scheduler/contracts to source, so no contracts build
# step is needed here -- unlike the API image, which resolves through dist.
# VITE_API_BASE_URL is left at its default of /api: the nginx layer below is
# the proxy that the dev server provides locally.
RUN pnpm --filter @scheduler/web build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
