          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(booking_attempts_per_request_bucket[1m])))",
          "legendFormat": "p99",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scheduler-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(booking_attempts_per_request_bucket[1m])))",
          "legendFormat": "p50",
          "range": true,
          "refId": "B"
        }
      ]
    },
