{
  "uid": "scheduler-overview",
  "title": "Scheduler \u2014 runtime and booking",
  "description": "Process health and booking contention on one screen. The pairing is the point: generic RED signals cannot distinguish 'genuinely fully booked' from 'fighting itself', and the runtime row is how you tell whether contention is costing the process anything yet.",
  "tags": [
    "scheduler"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Node runtime \u2014 is the process struggling?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "GC time per second, by kind",
      "description": "Fraction of wall clock spent collecting. Sustained above a few percent means allocation pressure, and major collections appearing at all under load is the shape that precedes event-loop lag.",
      "datasource": {
        "type": "prometheus",
        "uid": "scheduler-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisLabel": ""
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scheduler-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (kind) (rate(nodejs_gc_duration_seconds_sum[1m]))",
          "legendFormat": "{{kind}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GC pause p99, by kind",
      "description": "How long a single collection stops the world. A booking holds a database connection while it runs, so a pause here is latency the client sees.",
      "datasource": {
        "type": "prometheus",
        "uid": "scheduler-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisLabel": ""
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scheduler-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, kind) (rate(nodejs_gc_duration_seconds_bucket[1m])))",
          "legendFormat": "{{kind}} p99",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Heap and resident memory",
      "description": "Used against total tells you whether V8 is growing the heap or reusing it. Used climbing while total is flat is normal; both climbing and never coming back down after load stops is a leak.",
      "datasource": {
        "type": "prometheus",
        "uid": "scheduler-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisLabel": ""
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scheduler-prometheus"
          },
          "editorMode": "code",
          "expr": "nodejs_heap_size_used_bytes",
          "legendFormat": "heap used",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scheduler-prometheus"
          },
          "editorMode": "code",
          "expr": "nodejs_heap_size_total_bytes",
          "legendFormat": "heap total",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scheduler-prometheus"
          },
          "editorMode": "code",
          "expr": "process_resident_memory_bytes",
          "legendFormat": "RSS",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scheduler-prometheus"
          },
          "editorMode": "code",
          "expr": "nodejs_external_memory_bytes",
          "legendFormat": "external",
          "range": true,
          "refId": "D"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Event loop lag",
      "description": "The single best proxy for connection-pool saturation in this service: requests waiting on a pool slot pile up as queued callbacks before anything else moves.",
      "datasource": {
        "type": "prometheus",
        "uid": "scheduler-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisLabel": ""
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scheduler-prometheus"
          },
          "editorMode": "code",
          "expr": "nodejs_eventloop_lag_p99_seconds",
          "legendFormat": "p99",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scheduler-prometheus"
          },
          "editorMode": "code",
          "expr": "nodejs_eventloop_lag_p50_seconds",
          "legendFormat": "p50",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scheduler-prometheus"
          },
          "editorMode": "code",
          "expr": "nodejs_eventloop_lag_mean_seconds",
          "legendFormat": "mean",
          "range": true,
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Heap spaces in use",
      "description": "Which V8 space is growing. Old-space growth is retained objects; new-space churn is short-lived allocation and is what drives minor GC frequency above.",
      "datasource": {
        "type": "prometheus",
        "uid": "scheduler-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisLabel": ""
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scheduler-prometheus"
          },
          "editorMode": "code",
          "expr": "nodejs_heap_space_size_used_bytes",
          "legendFormat": "{{space}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Handles, requests and file descriptors",
      "description": "Sockets that never close show up here first. Open FDs approaching the max is the failure that looks like a network problem and is not one. Open file descriptors come from /proc, so that series exists in the container and not on a host-run `pnpm start:dev` on macOS.",
      "datasource": {
        "type": "prometheus",
        "uid": "scheduler-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisLabel": ""
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scheduler-prometheus"
          },
          "editorMode": "code",
          "expr": "nodejs_active_handles_total",
          "legendFormat": "active handles",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scheduler-prometheus"
          },
          "editorMode": "code",
          "expr": "nodejs_active_requests_total",
          "legendFormat": "active requests",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scheduler-prometheus"
          },
          "editorMode": "code",
          "expr": "process_open_fds",
          "legendFormat": "open fds",
          "range": true,
          "refId": "C"
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Booking path \u2014 is the system fighting itself?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Booking outcomes per second",
      "description": "The five terminal states from BookingOutcome. `unavailable` rising is demand meeting a full calendar and is fine; `contended` and `rejected` rising is not.",
      "datasource": {
        "type": "prometheus",
        "uid": "scheduler-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisLabel": ""
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scheduler-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (outcome) (rate(booking_attempts_total[1m]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Conflicts and exhausted retries per second",
      "description": "Conflicts are writes the exclusion constraint refused -- the design working. Exhausted retries are customers who saw a failure, so that line is the one that maps to harm.",
      "datasource": {
        "type": "prometheus",
        "uid": "scheduler-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisLabel": ""
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scheduler-prometheus"
          },
          "editorMode": "code",
          "expr": "rate(booking_conflicts_total[1m])",
          "legendFormat": "conflicts",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "scheduler-prometheus"
          },
          "editorMode": "code",
          "expr": "rate(booking_retry_exhausted_total[1m])",
          "legendFormat": "retries exhausted",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Database attempts per booking",
      "description": "The early warning. It climbs before anything is user-visible. The histogram is bucketed at the retry limit, so p99 pinned at 3 means requests are only just surviving.",
      "datasource": {
        "type": "prometheus",
        "uid": "scheduler-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisLabel": ""
          }
        },
        "overrides": []
      },
      "options": {
