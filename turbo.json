{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },

    "//#format": {
      "cache": false
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "test:load": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["coverage/**"]
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "NODE_ENV",
    "PORT",
    "LOG_LEVEL",
    "THROTTLE_BURST_LIMIT",
    "THROTTLE_SUSTAINED_LIMIT",
    "OTEL_EXPORTER_OTLP_ENDPOINT"
  ]
}
