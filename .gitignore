# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.turbo/
coverage/
*.tsbuildinfo

# Docker bind-mounted database files. State, not source.
.data/
# Database files, if infra/docker-compose.prod.yml is ever run locally.
infra/data/

# Environment — never commit; see .env.example for the required keys
.env
.env.local
.env.*.local

# Secrets and key material. This repository is public: a committed key is
# published permanently, including to forks and code-search indexes.
*.pem
*.key
*.p12
*.pfx
id_rsa*

# The assessment brief belongs to the hiring company, not to this project.
# Kept local so publishing this repo does not expose their material.
purpose.txt

# Personal preparation material, not project deliverables.
# myDocs/ holds working notes and trade-off analyses written while building.
VIDEO.md
VIDEO_gpt.md
myDocs/
.claude/

# The recording itself. GitHub rejects blobs over 100 MB, and a large file
# committed once stays in history even after it is deleted.
*.mov
*.mp4

# Misc
*.log
.DS_Store
KeyloopCodingChallange.pdf
