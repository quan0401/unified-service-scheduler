# Where the Vite dev server forwards /api. Point this at the containerised API
# (http://localhost:13000) to get the raised throttle limits docker-compose sets.
VITE_API_PROXY_TARGET="http://localhost:3000"

# Base the browser calls. Leave as /api to use the dev-server proxy (default).
# Set to http://localhost:3000 to bypass the proxy and rely on CORS instead.
VITE_API_BASE_URL="/api"

# Optional: pre-fill the customer picker. Any id from `pnpm db:seed` output.
VITE_DEMO_CUSTOMER_ID=""
