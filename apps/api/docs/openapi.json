  "info": {
    "title": "Unified Service Scheduler API",
    "description": "Dealership service-appointment booking. Availability is advisory; booking is atomic and enforced by PostgreSQL exclusion constraints, so a slot can never be double-booked regardless of concurrency.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "CreateAppointmentDto": {
        "type": "object",
        "properties": {
          "dealershipId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
