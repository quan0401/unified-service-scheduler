# PostgreSQL 16 with the btree_gist extension available.
# Local Postgres.app default:
DATABASE_URL="postgresql://localhost:5432/scheduler?schema=public"
# docker-compose default:
# DATABASE_URL="postgresql://scheduler:scheduler@localhost:5432/scheduler?schema=public"

# Separate database used by the integration suite. It is dropped and recreated per run.
TEST_DATABASE_URL="postgresql://localhost:5432/scheduler_test?schema=public"

PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Slot hold time-to-live, seconds.
HOLD_TTL_SECONDS=120
# Fail fast rather than queueing under contention.
DB_LOCK_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=5000

# Rate limiting, per IP. Raise for load testing from a single address.
THROTTLE_BURST_LIMIT=20
THROTTLE_SUSTAINED_LIMIT=300

# Tracing is inert unless an OTLP collector is configured. `docker compose
# --profile observability` starts Jaeger; note the hostname differs by where
# the API is running -- `jaeger:4318` inside the compose network,
# `localhost:4318` for a local `pnpm start:dev` against a container.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_SERVICE_NAME="scheduler-api"
